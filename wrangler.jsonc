{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stronghold-protocol",
  // No account_id: Wrangler deploys to the account of `wrangler login` (or CLOUDFLARE_ACCOUNT_ID). docs/CLOUDFLARE.md
  "main": "dist/worker/index.mjs",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // workers.dev is unreachable from mainland China: the game is served only on its own domain (a zone of the same
  // account): 卫.rinko.ai, written in punycode.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "xn--rlr.rinko.ai", "custom_domain": true }],
  "build": { "command": "npm run build:worker" },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/ws", "/healthz"],
    "not_found_handling": "none"
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "RoomDurableObject" },
      { "name": "ADMISSION", "class_name": "AdmissionDurableObject" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RoomDurableObject", "AdmissionDurableObject"] }
  ]
}

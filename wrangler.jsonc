{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stronghold-protocol",
  "account_id": "04c35e69fed6151decdffdd2952f7771",
  "main": "dist/worker/index.mjs",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  // Workers Logs: the structured lines of worker/log.js, uncaught errors and one line per invocation. Deployments send
  // this setting, so a dashboard toggle alone would be switched off again by the next deploy. Query strings are
  // redacted: /ws carries room tickets and the OAuth callback its code and state.
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": { "enabled": true, "invocation_logs": true }
  },
  "vars": {
    "AUTH_ORIGIN": "https://stronghold.lunar.ag",
    "GITHUB_CLIENT_ID": "Ov23liVRPUgvbQPtKkoo"
  },
  // Allow Workers Builds previews; no preview-specific room bindings are configured.
  "previews": {},
  // Custom domains and routes are managed in the Cloudflare dashboard.
  // Omit route/routes so deployments preserve those bindings.
  "build": { "command": "npm run build:worker" },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/ws", "/healthz", "/stronghold-resources.zip"],
    "not_found_handling": "none"
  },
  // Request limits per minute, per network (and per account for room connections): worker/index.js `within`.
  "ratelimits": [
    { "name": "RESERVE_LIMIT", "namespace_id": "1001", "simple": { "limit": 8, "period": 60 } },
    { "name": "CONNECT_LIMIT", "namespace_id": "1002", "simple": { "limit": 40, "period": 60 } },
    { "name": "STATUS_LIMIT", "namespace_id": "1003", "simple": { "limit": 120, "period": 60 } },
    { "name": "AUTH_LIMIT", "namespace_id": "1004", "simple": { "limit": 10, "period": 60 } },
    { "name": "APPLICATION_LIMIT", "namespace_id": "1005", "simple": { "limit": 30, "period": 60 } }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "RoomDurableObject" },
      { "name": "SITES", "class_name": "SiteDirectory" },
      { "name": "ACCOUNTS", "class_name": "AccountDurableObject" },
      { "name": "MATCH_ARCHIVES", "class_name": "MatchArchive" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RoomDurableObject", "AdmissionDurableObject"] },
    { "tag": "v2-accounts", "new_sqlite_classes": ["SiteDirectory", "AccountDurableObject", "MatchArchive"] },
    // The per-network limiter object, replaced by the ratelimits bindings (its storage held only short-lived counters).
    { "tag": "v3-ratelimits", "deleted_classes": ["AdmissionDurableObject"] }
  ]
}
